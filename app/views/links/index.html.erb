<div class="w-full max-w-4xl mx-auto pb-16">
  <%= render "shared/header" %>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-8">
    <h1 class="text-lg font-semibold text-slate-800 mb-4"><%= t("links.create_title") %></h1>

    <% if @link.errors.any? %>
      <div class="mb-4 rounded-lg bg-red-50 border border-red-200 p-4 text-red-700 text-sm">
        <ul class="list-disc ps-5 space-y-1">
          <% @link.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @link, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :original_url, t("links.original_url_label"), class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.url_field :original_url, placeholder: t("links.original_url_placeholder"), required: true, dir: "ltr",
            class: "w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-800 focus:border-indigo-500 focus:outline-none" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
        <div class="md:col-span-2">
          <%= f.label :short_code, t("links.short_code_label"), class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :short_code, placeholder: t("links.short_code_placeholder"), dir: "ltr",
              class: "w-full rounded-lg border border-slate-300 px-4 py-2.5 text-slate-800 focus:border-indigo-500 focus:outline-none" %>
        </div>
        <div>
          <%= f.submit t("actions.shorten"),
              class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-6 rounded-lg transition cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center">
      <h2 class="font-semibold text-slate-800"><%= t("links.your_links") %> (<%= @links.count %>)</h2>
      <span class="text-xs text-slate-500"><%= t("links.total_clicks") %>: <%= @links.sum(:clicks_count) %></span>
    </div>

    <% if @links.empty? %>
      <div class="p-10 text-center text-slate-500 text-sm">
        <%= t("links.empty_state") %>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-start text-sm">
          <thead class="bg-slate-50 text-slate-600 border-b border-slate-200">
            <tr>
              <th class="px-6 py-3 font-medium text-start"><%= t("links.table.short_link") %></th>
              <th class="px-6 py-3 font-medium text-start"><%= t("links.table.destination") %></th>
              <th class="px-6 py-3 font-medium text-center"><%= t("links.table.clicks") %></th>
              <th class="px-6 py-3 font-medium text-end"><%= t("links.table.actions") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <% @links.each do |link| %>
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center gap-2">
                    <%= link_to short_url(link.short_code), short_path(link.short_code), target: "_blank", dir: "ltr",
                        class: "font-mono text-indigo-600 hover:underline font-medium" %>
                    <button type="button"
                            data-url="<%= short_url(link.short_code) %>"
                            data-copy="<%= t('actions.copy') %>"
                            data-copied="<%= t('actions.copied') %>"
                            onclick="navigator.clipboard.writeText(this.dataset.url); this.innerText=this.dataset.copied; setTimeout(() => this.innerText=this.dataset.copy, 1500)"
                            class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-2 py-1 rounded cursor-pointer">
                      <%= t("actions.copy") %>
                    </button>
                  </div>
                </td>
                <td class="px-6 py-4 max-w-xs truncate text-slate-600" dir="ltr" title="<%= link.original_url %>">
                  <%= link.original_url %>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700">
                    <%= link.clicks_count %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-end">
                  <div class="inline-flex items-center gap-3">
                    <%= link_to t("actions.analytics"), link_path(link), class: "text-slate-700 hover:text-indigo-600 font-medium" %>
                    <%= button_to t("actions.delete"), link_path(link), method: :delete,
                        form: { onsubmit: "return confirm('#{j t('links.confirm_delete')}')" },
                        class: "text-red-600 hover:text-red-800 font-medium cursor-pointer" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>