<div class="w-full max-w-4xl mx-auto pb-16">
  <%= render "shared/header" %>

  <div class="mb-6">
    <%= link_to t("actions.back_to_dashboard"), root_path, class: "text-sm text-indigo-600 hover:underline font-medium" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="md:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
      <div class="text-xs uppercase tracking-wide text-slate-500 mb-1"><%= t("analytics.short_url") %></div>
      <div class="flex items-center gap-3 mb-3">
        <%= link_to short_url(@link.short_code), short_path(@link.short_code), target: "_blank", dir: "ltr",
            class: "font-mono text-xl font-bold text-indigo-600 hover:underline" %>
        <button type="button"
                data-url="<%= short_url(@link.short_code) %>"
                data-copy="<%= t('actions.copy') %>"
                data-copied="<%= t('actions.copied') %>"
                onclick="navigator.clipboard.writeText(this.dataset.url); this.innerText=this.dataset.copied; setTimeout(() => this.innerText=this.dataset.copy, 1500)"
                class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1 rounded cursor-pointer">
          <%= t("actions.copy") %>
        </button>
      </div>
      <div class="text-sm text-slate-600 break-all">
        <span class="font-medium text-slate-700"><%= t("analytics.destination") %>:</span>
        <span dir="ltr"><%= @link.original_url %></span>
      </div>
    </div>

    <div class="bg-indigo-600 text-white rounded-2xl shadow-sm p-6 flex flex-col justify-center">
      <div class="text-xs uppercase tracking-wide text-indigo-200 mb-1"><%= t("analytics.total_clicks") %></div>
      <div class="text-4xl font-bold"><%= @link.clicks_count %></div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
      <h3 class="text-sm font-semibold text-slate-800 mb-3"><%= t("analytics.browsers") %></h3>
      <% if @browser_stats.empty? %>
        <p class="text-xs text-slate-400"><%= t("analytics.no_data") %></p>
      <% else %>
        <div class="space-y-2">
          <% @browser_stats.each do |browser, count| %>
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-600"><%= browser %></span>
              <span class="font-semibold text-slate-800"><%= count %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
      <h3 class="text-sm font-semibold text-slate-800 mb-3"><%= t("analytics.devices") %></h3>
      <% if @device_stats.empty? %>
        <p class="text-xs text-slate-400"><%= t("analytics.no_data") %></p>
      <% else %>
        <div class="space-y-2">
          <% @device_stats.each do |device, count| %>
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-600"><%= t("analytics.device_types.#{device}", default: device) %></span>
              <span class="font-semibold text-slate-800"><%= count %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200">
      <h2 class="font-semibold text-slate-800"><%= t("analytics.recent_clicks") %></h2>
    </div>

    <% if @click_events.empty? %>
      <div class="p-10 text-center text-slate-500 text-sm">
        <%= t("analytics.no_clicks") %>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-start text-sm">
          <thead class="bg-slate-50 text-slate-600 border-b border-slate-200">
            <tr>
              <th class="px-6 py-3 font-medium text-start"><%= t("analytics.time_utc") %></th>
              <th class="px-6 py-3 font-medium text-start"><%= t("analytics.browser") %></th>
              <th class="px-6 py-3 font-medium text-start"><%= t("analytics.device") %></th>
              <th class="px-6 py-3 font-medium text-start"><%= t("analytics.referer") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <% @click_events.each do |event| %>
              <tr>
                <td class="px-6 py-3 whitespace-nowrap text-slate-700" dir="ltr">
                  <%= event.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
                </td>
                <td class="px-6 py-3 text-slate-700 font-medium"><%= event.browser_name %></td>
                <td class="px-6 py-3 text-slate-600"><%= t("analytics.device_types.#{event.device_type}", default: event.device_type) %></td>
                <td class="px-6 py-3 text-slate-600"><% if event.referer.present? %><span dir="ltr"><%= event.referer %></span><% else %><%= t("analytics.direct") %><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>