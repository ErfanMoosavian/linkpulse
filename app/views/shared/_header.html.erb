<div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 pb-4 mb-8">
  <%= link_to root_path, class: "flex items-center gap-2.5 text-2xl font-bold text-indigo-600" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
    </svg>
    <span dir="ltr"><%= t("app.name") %></span>
    <span class="text-xs font-medium bg-indigo-100 text-indigo-700 px-2.5 py-0.5 rounded-full"><%= t("app.badge") %></span>
  <% end %>

  <div class="flex items-center gap-4">
    <span class="hidden sm:inline text-sm text-slate-500"><%= t("app.tagline") %></span>
    <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-xs font-medium shadow-xs">
      <%= link_to "EN", switch_locale_path(:en),
          class: "px-2.5 py-1 rounded-md transition #{I18n.locale == :en ? 'bg-indigo-600 text-white' : 'text-slate-600 hover:text-indigo-600'}" %>
      <%= link_to "فارسی", switch_locale_path(:fa),
          class: "px-2.5 py-1 rounded-md transition #{I18n.locale == :fa ? 'bg-indigo-600 text-white' : 'text-slate-600 hover:text-indigo-600'}" %>
    </div>
  </div>
</div>

<% if notice %>
  <div class="mb-6 rounded-xl bg-emerald-50 border border-emerald-200 p-4 text-emerald-800 text-sm">
    <%= notice %>
  </div>
<% end %>

<% if alert %>
  <div class="mb-6 rounded-xl bg-red-50 border border-red-200 p-4 text-red-800 text-sm">
    <%= alert %>
  </div>
<% end %>